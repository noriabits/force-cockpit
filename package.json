{
  "name": "force-cockpit",
  "displayName": "Force Cockpit",
  "description": "Salesforce utilities cockpit for VSCode",
  "version": "1.0.9",
  "license": "MIT",
  "author": {
    "name": "Pablo Fernández Posadas",
    "email": "pablo@noriabits.com"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "publisher": "noriabits",
  "icon": "media/fc-logo.png",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noriabits/force-cockpit"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forceCockpit",
          "title": "Force Cockpit",
          "icon": "media/logoside.png"
        }
      ]
    },
    "views": {
      "forceCockpit": [
        {
          "id": "forceCockpit.panel",
          "name": "Force Cockpit",
          "icon": "media/logoside.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "forceCockpit.panel",
        "contents": "[Open Force Cockpit](command:forceCockpit.openPanel)"
      }
    ],
    "commands": [
      {
        "command": "forceCockpit.openPanel",
        "title": "Open Cockpit",
        "category": "Force Cockpit",
        "icon": "$(layout-panel)"
      },
      {
        "command": "forceCockpit.openInBrowser",
        "title": "Open in Browser",
        "category": "Force Cockpit",
        "icon": "$(globe)"
      }
    ],
    "configuration": {
      "title": "Force Cockpit",
      "properties": {
        "forceCockpit.cockpitPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the force-cockpit folder containing YAML script and monitoring definitions. Defaults to {workspace root}/force-cockpit if empty."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.mjs",
    "compile": "tsc -p ./tsconfig.host.json && tsc -p ./tsconfig.webview.json",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"src/features/**/*.{js,css,html}\" \"src/webview/**/*.js\" \"media/**/*.{js,css}\" \"webviews/**/*.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"src/features/**/*.{js,css,html}\" \"src/webview/**/*.js\" \"media/**/*.{js,css}\" \"webviews/**/*.html\"",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --audit-level=high --omit=dev",
    "package": "vsce package",
    "prepare": "husky",
    "install:ext": "code --install-extension force-cockpit-0.0.1.vsix"
  },
  "lint-staged": {
    "src/features/**/*.{js,css,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "media/**/*.{js,css}": [
      "prettier --write"
    ],
    "webviews/**/*.html": [
      "prettier --write"
    ],
    "scripts/**/*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "eslint": "^10.0.0",
    "form-data": "4.0.6"
  },
  "dependencies": {
    "@jsforce/jsforce-node": "3.10.16",
    "@preact/signals": "2.6.1",
    "@salesforce/core": "8.31.1",
    "@xmldom/xmldom": "0.9.10",
    "chart.js": "4.5.1",
    "ignore": "7.0.5",
    "js-yaml": "4.3.1",
    "preact": "10.28.3",
    "xml-formatter": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/preact": "3.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.57.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "27.0.0",
    "knip": "6.34.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  }
}
